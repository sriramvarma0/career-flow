# Database Configuration (SQLite)
DATABASE_URL="file:../data/database/dev.db"

# Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Document Storage Provider Configuration
# Options: "local" or "cloud"
STORAGE_PROVIDER="local"

# Cloud Object Storage Configuration (Cloudflare R2 / AWS S3 Compatible)
# Required when STORAGE_PROVIDER="cloud"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""